{
  "name": "chatgate",
  "version": "1.0.0",
  "description": "Multi-user chat app with shared server storage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently -k \"node server.js\" \"npm run dev:client\"",
    "dev:client": "vite --config client/vite.config.js",
    "build": "node scripts/copy-static.js",
    "build:react": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "pg": "^8.13.1",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.3"
  }
}
